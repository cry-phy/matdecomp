*

!.gitignore
!.clang-format
# .clangd is machine-local (conda paths, GPU arch) — not tracked
.clangd

!include/
!include/**

!src/
!src/**

!tests/
!tests/**

!benchmarks/
!benchmarks/**

# Plotting scripts are tracked; the venv and generated PNGs are not.
!plot/
!plot/plot_benchmarks.py
!plot/requirements.txt

!**/CMakeLists.txt
